{
  "type": "module",
  "name": "a2a-agent-example",
  "version": "0.1.0",
  "description": "A weather agent on the Claude Agent SDK, served over A2A 1.0, with an interactive A2A command-line client.",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/server/main.ts",
    "dev": "node --import=tsx --watch --env-file=.env src/server/main.ts",
    "cli": "node --env-file=.env src/client/main.ts",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
