# The port the agents listen on; the CLI connects to the trip planner on it when given no URL.
PORT=41241
# The runner each agent runs on: claude, codex or pi. The model is optional for claude and codex (their own default
# when unset) and required for pi, as provider/model, such as anthropic/claude-sonnet-4-6.
WEATHER_AGENT_RUNNER=claude
# WEATHER_AGENT_MODEL=
TRIP_PLANNER_RUNNER=codex
# TRIP_PLANNER_MODEL=
# Claude signs in the way Claude Code does on this machine. Set a key only if Claude Code has no other credentials
# here, from https://console.anthropic.com. Pi reads it too, for anthropic/ models; for other providers, set theirs
# (OPENAI_API_KEY, ...).
# ANTHROPIC_API_KEY=
# Codex signs in the way the Codex CLI does on this machine (`codex login`). Set a key only if it has no other
# credentials here, from https://platform.openai.com.
# CODEX_API_KEY=
# How much the agent logs: debug by default, info when NODE_ENV=production.
# LOG_LEVEL=debug
