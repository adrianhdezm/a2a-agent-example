{
  "name": "@a2a-agent-example/eslint-config",
  "version": "0.0.0",
  "description": "The house ESLint rules, as config({ tsconfigRootDir }) for each package's eslint.config.js.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.73.0"
  },
  "devDependencies": {
    "@a2a-agent-example/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
