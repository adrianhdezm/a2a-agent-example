{
  "name": "@a2a-agent-example/server",
  "version": "0.0.0",
  "description": "The weather agent: the Claude Agent SDK behind an A2A 1.0 endpoint.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=../../.env src/server.ts",
    "dev": "node --import=tsx --watch --env-file=../../.env src/server.ts",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@a2a-agent-example/eslint-config": "workspace:*",
    "@a2a-agent-example/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@a2a-agent-example/shared": "workspace:*",
    "@a2a-js/sdk": "catalog:",
    "@anthropic-ai/claude-agent-sdk": "^0.3.331",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
