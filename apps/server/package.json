{
  "name": "@a2a-agent-example/server",
  "version": "0.0.0",
  "description": "A2A server that exposes each registered agent as its own A2A 1.0 endpoint.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=../../.env src/server.ts",
    "dev": "node --import=tsx --watch --env-file=../../.env src/server.ts | pino-pretty --colorize --singleLine --translateTime 'HH:MM:ss.l' --ignore pid,hostname,req.headers,res.headers",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@a2a-agent-example/eslint-config": "workspace:*",
    "@a2a-agent-example/tsconfig": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "^13.2.0",
    "prettier": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@a2a-agent-example/harness-claude": "workspace:*",
    "@a2a-agent-example/harness-codex": "workspace:*",
    "@a2a-agent-example/harness-core": "workspace:*",
    "@a2a-js/sdk": "catalog:",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "http-errors": "^2.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  }
}
